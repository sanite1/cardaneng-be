# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=4000

# Allowed origin for the frontend (use the deployed site URL in production)
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string. Local example shown; in production use a
# MongoDB Atlas SRV URI: mongodb+srv://<user>:<pass>@<cluster>/cardaneng
MONGODB_URI=mongodb://127.0.0.1:27017/cardaneng

# Secret used to sign admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# How long an admin login stays valid (e.g. 7d, 12h, 30m)
JWT_EXPIRES=7d

# Initial admin — seeded into the Users collection on first run only, then
# ignored. Passwords are stored bcrypt-hashed; change it afterwards via
# POST /api/auth/change-password.
ADMIN_USER=admin
ADMIN_PASS=cardan2026

# Cloudinary — used for image uploads (POST /api/uploads).
# Find these on your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Folder that uploaded images are stored under (optional)
CLOUDINARY_FOLDER=cardaneng

# Email (Nodemailer) — used by the contact form (POST /api/contact) to notify
# the company and send the sender a confirmation. Use your SMTP provider's
# values (e.g. a transactional service, or Gmail/Zoho/cPanel mailbox SMTP).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false           # true if using port 465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# "From" address shown on outgoing mail (often must match SMTP_USER's domain)
MAIL_FROM=Cardan Engineering <no-reply@cardaneng.com>
# Where contact-form enquiries are delivered
CONTACT_RECIPIENT=info@cardaneng.com
# Company name used in email copy
COMPANY_NAME=Cardan Engineering Limited

# Cloudflare Turnstile (optional CAPTCHA on the contact form). Leave empty to
# disable. Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# The matching site key goes in the FRONTEND env as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=
